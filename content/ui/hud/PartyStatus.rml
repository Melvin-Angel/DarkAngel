<rml><head><title>PartyStatus</title></head><body data-model="owner"><div id="state" data-if="dead &amp;&amp; !downed &amp;&amp; !wiped">Defeated</div><div id="downed" data-if="downed &amp;&amp; !wiped">Downed<div class="caption">A teammate can revive you by holding Interact</div></div><div id="wiped" data-if="wiped &amp;&amp; !loading">Party defeated<div class="caption">Returning to the last altar</div></div><div id="revive" data-if="reviving &amp;&amp; !loading"><div id="revive-text" class="caption">{{revive_text}}</div><div id="revive-bar" class="bar"><div id="revive-fill" class="fill progress" data-style-width="revive_percent + '%'"></div></div></div></body></rml>
