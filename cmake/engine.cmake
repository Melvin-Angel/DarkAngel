if(DAE_NETWORK_GNS)
  file(READ "${PROJECT_SOURCE_DIR}/cmake/m3-gns-port-exception.json" gns_exception)
  foreach(file portfile.cmake vcpkg.json)
    string(JSON expected_hash GET "${gns_exception}" overlay_sha256 "${file}")
    file(SHA256 "${PROJECT_SOURCE_DIR}/cmake/overlay-ports/gamenetworkingsockets/${file}" actual_hash)
    if(NOT actual_hash STREQUAL expected_hash)
      message(FATAL_ERROR "Recorded GNS port exception drift: ${file}")
    endif()
  endforeach()
  find_package(GameNetworkingSockets CONFIG REQUIRED)
  add_library(DarkAngelNetwork STATIC engine/runtime/gns_transport.cpp)
  target_link_libraries(DarkAngelNetwork PUBLIC DarkAngelRuntime PRIVATE GameNetworkingSockets::static)
  target_compile_options(DarkAngelNetwork PRIVATE /W4 /utf-8 /EHsc)
endif()
if(DAE_NETWORK_EOS)
  include(cmake/EOS.cmake)
  darkangel_import_eos("${DAE_EOS_SDK_ROOT}")
  file(READ "${PROJECT_SOURCE_DIR}/cmake/eos.lock.json" eos_lock)
  string(JSON eos_file_count LENGTH "${eos_lock}" files)
  math(EXPR eos_last_file "${eos_file_count}-1")
  foreach(index RANGE ${eos_last_file})
    string(JSON file MEMBER "${eos_lock}" files ${index})
    string(JSON expected_hash GET "${eos_lock}" files "${file}")
    file(SHA256 "${DAE_EOS_SDK_ROOT}/${file}" actual_hash)
    if(NOT actual_hash STREQUAL expected_hash)
      message(FATAL_ERROR "Pinned EOS artifact drift: ${file}")
    endif()
  endforeach()
  add_library(DarkAngelOnline STATIC engine/runtime/eos_session.cpp)
  target_link_libraries(DarkAngelOnline PUBLIC DarkAngelRuntime PRIVATE DarkAngel::EOS)
  target_compile_options(DarkAngelOnline PRIVATE /W4 /utf-8 /EHsc)
  if(NOT DAE_SHIPPING)
    add_executable(OnlineProbe apps/headless/online_probe.cpp)
    target_link_libraries(OnlineProbe PRIVATE DarkAngelOnline nlohmann_json::nlohmann_json)
    add_custom_command(TARGET OnlineProbe POST_BUILD COMMAND "${CMAKE_COMMAND}" -E copy_if_different "$<TARGET_FILE:DarkAngel::EOS>" "$<TARGET_FILE_DIR:OnlineProbe>")
  endif()
  if(BUILD_TESTING)
    add_executable(EosTests tests/eos_tests.cpp)
    target_link_libraries(EosTests PRIVATE DarkAngelOnline)
    add_custom_command(TARGET EosTests POST_BUILD COMMAND "${CMAKE_COMMAND}" -E copy_if_different "$<TARGET_FILE:DarkAngel::EOS>" "$<TARGET_FILE_DIR:EosTests>")
    add_test(NAME M3.eos_sdk_boundary COMMAND EosTests)
    set_tests_properties(M3.eos_sdk_boundary PROPERTIES TIMEOUT 10 LABELS "M3;online-sdk")
  endif()
endif()
if(DAE_ANIMATION)
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${PROJECT_SOURCE_DIR}/third_party/ozz" rev-parse HEAD OUTPUT_VARIABLE ozz_revision OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
  if(NOT ozz_revision STREQUAL "744eb9d99f606eda849acb0b1204f7a3dc20bca1")
    message(FATAL_ERROR "Frozen Ozz source revision drift")
  endif()
  set(ozz_build_tools OFF CACHE BOOL "Use owned cgltf normalizer and offline builders" FORCE)
