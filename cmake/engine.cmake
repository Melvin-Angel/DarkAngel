  set(ozz_build_gltf OFF CACHE BOOL "One owned glTF normalization contract" FORCE)
  set(ozz_build_samples OFF CACHE BOOL "" FORCE)
  set(ozz_build_howtos OFF CACHE BOOL "" FORCE)
  set(ozz_build_tests OFF CACHE BOOL "" FORCE)
  set(ozz_build_data OFF CACHE BOOL "" FORCE)
  set(ozz_build_msvc_rt_dll ON CACHE BOOL "Match engine dynamic CRT" FORCE)
  add_subdirectory(third_party/ozz EXCLUDE_FROM_ALL)
  add_library(DarkAngelAnimation STATIC engine/runtime/animation_pose.cpp engine/runtime/animation_graph.cpp)
  target_link_libraries(DarkAngelAnimation PUBLIC DarkAngelRuntime PRIVATE ozz_animation)
  target_compile_options(DarkAngelAnimation PRIVATE /W4 /utf-8 /EHsc)
endif()
