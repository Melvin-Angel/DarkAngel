<rml>
<head>
<title>Ashen Roots combat HUD</title>
<style>
body { font-family: HUD; font-size: 16px; color: #f2ede4; width: 100%; height: 100%; }
div { display: block; }
.panel { position: absolute; }
#player { left: 24px; bottom: 24px; width: 320px; }
#target { top: 20px; left: 50%; width: 360px; margin-left: -180px; }
.bar { position: relative; height: 22px; margin-top: 6px; background-color: #101216c8; border: 1px #000000a0; }
.fill { position: absolute; left: 0px; top: 0px; height: 100%; }
.health { background-color: #b3262b; }
.stamina { background-color: #3f9f58; }
.enemy { background-color: #c4762a; }
.label { position: absolute; left: 8px; top: 2px; font-size: 14px; }
.caption { font-size: 13px; color: #d8d1c4; }
.mask { font-size: 18px; margin-bottom: 2px; }
#crosshair { position: absolute; left: 50%; top: 50%; width: 24px; height: 24px; margin-left: -12px; margin-top: -14px; text-align: center; font-size: 22px; color: #ffffffd0; }
.lock { font-size: 13px; color: #f0c674; margin-top: 4px; text-align: center; }
#prompt { position: absolute; left: 0px; right: 0px; top: 62%; text-align: center; font-size: 18px; color: #f0e6d2; }
#state, #downed, #wiped { position: absolute; left: 0px; right: 0px; top: 36%; text-align: center; font-size: 36px; color: #e8dccb; }
#wiped { color: #e05a4a; }
#revive { position: absolute; left: 35%; width: 30%; top: 68%; text-align: center; }
#loading { position: absolute; left: 0px; top: 0px; width: 100%; height: 100%; background-color: #0b0d11f8; }
#loading-title { position: absolute; left: 0px; right: 0px; top: 40%; text-align: center; font-size: 30px; color: #e8dccb; }
#loading-text { position: absolute; left: 0px; right: 0px; top: 50%; text-align: center; font-size: 15px; color: #b9b2a6; }
#loading-bar { position: absolute; left: 30%; width: 40%; top: 57%; height: 8px; background-color: #1d2128; border: 1px #000000a0; }
.progress { background-color: #c9a45c; }
.world-marker { position: absolute; text-align: center; color: #f2ede4; pointer-events: none; }
.world-caption { background-color: #101216c8; border-radius: 3px; padding: 2px; }
.world-health { position: relative; background-color: #101216d8; border: 1px #000000a0; margin-top: 3px; }
.world-fill { background-color: #c4762a; height: 100%; }
</style>
</head>
<body data-model="hud">
<div id="world-ui" data-if="!loading">
<div class="world-marker" data-for="marker, marker_index : world_markers" data-attr-id="'world-marker-' + marker_index" data-style-left="marker.x + 'px'" data-style-top="marker.y + 'px'" data-style-width="marker.width + 'px'" data-style-font-size="marker.font + 'px'">
<div class="world-caption">{{marker.label}}</div>
<div class="world-health" data-if="marker.health_bar" data-style-height="marker.height + 'px'"><div class="world-fill" data-style-width="marker.percent + '%'"></div></div>
</div>
</div>
<div id="target" class="panel" data-if="has_target">
	<div id="target-name" class="caption">{{target_name}}</div>
	<div id="target-bar" class="bar"><div id="target-fill" class="fill enemy" data-style-width="target_percent + '%'"></div><div id="target-text" class="label">{{target_text}}</div></div>
	<div id="lock" class="lock" data-if="target_locked">Locked on</div>
</div>
<div id="crosshair" data-if="crosshair">+</div>
<div id="prompt" data-if="has_prompt">{{prompt}}</div>
<div id="state" data-if="dead &amp;&amp; !downed &amp;&amp; !wiped">Defeated</div>
<div id="downed" data-if="downed &amp;&amp; !wiped">Downed<div class="caption">A teammate can revive you by holding Interact</div></div>
<div id="wiped" data-if="wiped &amp;&amp; !loading">Party defeated<div class="caption">Returning to the last altar</div></div>
<div id="revive" data-if="reviving &amp;&amp; !loading"><div id="revive-text" class="caption">{{revive_text}}</div><div id="revive-bar" class="bar"><div id="revive-fill" class="fill progress" data-style-width="revive_percent + '%'"></div></div></div>
<div id="player" class="panel">
	<div id="mask" class="mask" data-if="has_mask">{{mask}}</div>
	<div id="stagger" class="caption" data-if="staggered">Staggered</div>
	<div id="health-bar" class="bar"><div id="health-fill" class="fill health" data-style-width="health_percent + '%'"></div><div id="health-text" class="label">{{health_text}}</div></div>
	<div id="stamina-bar" class="bar"><div id="stamina-fill" class="fill stamina" data-style-width="stamina_percent + '%'"></div><div id="stamina-text" class="label">{{stamina_text}}</div></div>
</div>
<div id="loading" data-if="loading">
	<div id="loading-title">Travelling</div>
	<div id="loading-text">{{loading_text}}</div>
	<div id="loading-bar"><div id="loading-fill" class="fill progress" data-style-width="loading_percent + '%'"></div></div>
</div>
</body>
</rml>
